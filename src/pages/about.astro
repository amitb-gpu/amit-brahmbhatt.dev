---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---

<Base title="About" description="About Amit Brahmbhatt — software engineering leader and technical founder.">
  <div class="page-head">
    <p class="eyebrow">Profile</p>
    <h2>About</h2>
  </div>

  <section class="about-intro reveal">
    <figure class="portrait">
      <img src="/profile.jpg" alt="Portrait of Amit Brahmbhatt" width="800" height="1000" />
    </figure>
    <div>
    <p style="font-size: 1.12rem; color: var(--text);">
      I'm Amit Brahmbhatt, a software engineering leader and technical founder.
      I build practical software around modern AI — applications, developer
      tools, agent systems, and infrastructure powered by LLMs and related
      technologies.
    </p>
    <p style="color: var(--muted);">
      My work usually starts with an idea and ends with working software —
      through system architecture, implementation, experimentation, evaluation,
      measurement, and deployment.
    </p>
    <p style="color: var(--muted);">
      I work across Python, C++, APIs, model tooling, and infrastructure as
      needed to take ideas from architecture through implementation and
      validation. My strength is designing systems, measuring their behavior,
      and turning emerging technologies into working products. Thirty-six
      public repositories across two GitHub accounts trace the throughline:
      measure first, trust evidence over intuition, and publish the null
      results too.
    </p>
    <p style="color: var(--muted);">
      On the venture side, I'm building HexaGrid — AI-infrastructure cost
      optimization, taking it into paid enterprise design partners. I'm based
      in {site.location}.
    </p>
    </div>
  </section>

  <section>
    <div class="cta-panel">
      <h2>Collaborate</h2>
      <p>
        I collaborate on hard technical problems — open source, research, or
        venture — especially in AI infrastructure, security, and quantum systems.
      </p>
      <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
        {site.socials.map((s) => (
          <a class="btn btn-ghost btn-sm" href={s.url} target="_blank" rel="noopener">{s.label} ↗</a>
        ))}
      </div>
    </div>
  </section>
</Base>
