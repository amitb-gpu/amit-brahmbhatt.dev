---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";
import { ideas } from "../data/ideas";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featured = projects.filter((p) => p.featured);
const exploring = ideas.filter((i) => i.status === "exploring" || i.status === "building").slice(0, 2);

const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Base>
  <div class="hero">
    <h1>Hi, I'm {site.name}.</h1>
    <p class="tagline">{site.tagline}</p>
    <p class="lede">{site.description}</p>
  </div>

  <section>
    <h2><a href="/blog">Latest writing →</a></h2>
    {posts.length === 0 && <p class="meta">No posts yet — check back soon.</p>}
    {posts.map((post) => (
      <div class="post-row">
        <div>
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
          <p class="desc">{post.data.description}</p>
        </div>
        <time>{fmt(post.data.pubDate)}</time>
      </div>
    ))}
  </section>

  <section>
    <h2><a href="/projects">Featured projects →</a></h2>
    {featured.map((p) => (
      <div class="card">
        <h3>{p.url ? <a href={p.url}>{p.name}</a> : p.name}</h3>
        <p>{p.description}</p>
        <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
      </div>
    ))}
  </section>

  <section>
    <h2><a href="/ideas">Ideas I'm exploring →</a></h2>
    {exploring.map((i) => (
      <div class="card">
        <span class={`status ${i.status}`}>{i.status}</span>
        <h3>{i.title}</h3>
        <p>{i.description}</p>
      </div>
    ))}
  </section>
</Base>
