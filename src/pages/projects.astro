---
import Base from "../layouts/Base.astro";
import { projects } from "../data/projects";

const areaLabels: Record<string, string> = {
  "ai-gpu": "AI & GPU",
  trustworthy: "Trustworthy AI",
  quantum: "Quantum",
  other: "Other",
};

const orgs = [
  { id: "amitb-gpu", title: "GPU & AI infrastructure", url: "https://github.com/amitb-gpu" },
  { id: "amitb-quantum", title: "Quantum, security & AI systems", url: "https://github.com/amitb-quantum" },
] as const;

const areaFilters = ["all", "ai-gpu", "trustworthy", "quantum", "other"] as const;
const statusFilters = ["all", "active", "quiet", "archived"] as const;
---

<Base title="Projects" description="Full repository catalog across both GitHub accounts, filterable by category and status.">
  <div class="page-head">
    <p class="eyebrow">Catalog</p>
    <h2>Projects</h2>
    <p class="lede">
      Every public repository across both GitHub accounts. Filter by category
      and status — or start with the <a href="/">six featured case studies</a>.
    </p>
  </div>

  <section style="padding-top: 1.75rem;">
    <div class="filters">
      <div class="filter-group" data-filter="area">
        <span class="lbl">Category</span>
        {areaFilters.map((a) => (
          <button class={`chip${a === "all" ? " on" : ""}`} data-value={a}>
            {a === "all" ? "All" : areaLabels[a]}
          </button>
        ))}
      </div>
      <div class="filter-group" data-filter="status">
        <span class="lbl">Status</span>
        {statusFilters.map((s) => (
          <button class={`chip${s === "all" ? " on" : ""}`} data-value={s}>
            {s === "all" ? "All" : s}
          </button>
        ))}
      </div>
      <p class="meta" id="count"></p>
    </div>

    {orgs.map((org) => (
      <div class="org-section" data-org={org.id} style="margin-bottom: 2.5rem;">
        <div class="org-head">
          <h3>
            <a href={org.url} target="_blank" rel="noopener">github.com/{org.id}</a>
            <span class="meta"> — {org.title}</span>
          </h3>
        </div>
        {projects
          .filter((p) => p.org === org.id)
          .map((p) => (
            <div class="card" data-area={p.area} data-status={p.status}>
              <h3>
                <a href={p.url} target="_blank" rel="noopener">{p.name}</a>
              </h3>
              <p class="meta"><span class={`dot ${p.status}`}></span>{areaLabels[p.area]} · {p.status}</p>
              <p>{p.description}</p>
              <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
            </div>
          ))}
      </div>
    ))}

    <p class="meta">
      Status is derived from GitHub metadata: active = pushed in the last 180
      days, archived = GitHub archived flag, otherwise quiet.
    </p>
  </section>

  <script>
    const state = { area: "all", status: "all" };
    const cards = [...document.querySelectorAll(".card[data-area]")];
    const sections = [...document.querySelectorAll(".org-section")];
    const count = document.getElementById("count");

    function apply() {
      let visible = 0;
      for (const card of cards) {
        const show =
          (state.area === "all" || card.dataset.area === state.area) &&
          (state.status === "all" || card.dataset.status === state.status);
        card.style.display = show ? "" : "none";
        if (show) visible++;
      }
      for (const sec of sections) {
        const any = [...sec.querySelectorAll(".card")].some((c) => c.style.display !== "none");
        sec.style.display = any ? "" : "none";
      }
      if (count) count.textContent = `showing ${visible} of ${cards.length}`;
    }

    document.querySelectorAll(".filter-group").forEach((group) => {
      const key = group.dataset.filter;
      group.querySelectorAll(".chip").forEach((chip) => {
        chip.addEventListener("click", () => {
          group.querySelectorAll(".chip").forEach((c) => c.classList.remove("on"));
          chip.classList.add("on");
          state[key] = chip.dataset.value;
          apply();
        });
      });
    });

    apply();
  </script>
</Base>
