---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, area, problem, proof, github, tags } = entry.data;

const areaLabels: Record<string, string> = {
  "ai-gpu": "AI & GPU Systems",
  trustworthy: "Trustworthy / Secure AI",
  quantum: "Quantum & Scientific Computing",
};
---

<Base title={title} description={problem}>
  <article class="case">
    <p class="back"><a href="/">← Work</a></p>
    <h1>{title}</h1>
    <div class="case-meta">
      <span class="area-chip">{areaLabels[area]}</span>
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>

    <div class="brief">
      <div class="brief-row problem">
        <span class="kicker">Problem</span>
        <p>{problem}</p>
      </div>
      <div class="brief-row evidence">
        <span class="kicker">Evidence</span>
        <p>{proof}</p>
      </div>
    </div>

    <Content />

    <div class="case-links">
      <a class="btn btn-primary btn-sm" href={github} target="_blank" rel="noopener">{github.includes("zenodo.org") ? "View Zenodo deposit ↗" : "View on GitHub ↗"}</a>
      <a class="btn btn-ghost btn-sm" href="/projects">Full catalog →</a>
    </div>
  </article>
</Base>
